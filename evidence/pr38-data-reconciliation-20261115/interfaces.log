# ICD-ROS2-V1 | Static description of the terrain grid for one run.
# Topic: /mge/terrain/meta  (DataProvider -> all, reliable + transient_local)
#
# Grid convention (applies to every raster and OccupancyGrid of the run):
#   frame "map": x east, y north, z up, metres.
#   (origin_x_m, origin_y_m) is the south-west corner of cell (row 0, col 0).
#   row grows to the north, col grows to the east, flat index = row * cols + col.
#   cell centre: x = origin_x_m + (col + 0.5) * resolution_m
#                y = origin_y_m + (row + 0.5) * resolution_m

std_msgs/Header header          # frame_id = "map", stamp = simulated time
	builtin_interfaces/Time stamp
		int32 sec
		uint32 nanosec
	string frame_id
string run_id
string dataset_id
uint32 map_version              # grows with every valid observation

float64 origin_x_m
float64 origin_y_m
float64 resolution_m
uint32 rows
uint32 cols

# Georeference of the local origin. Planetocentric latitude, east-positive
# longitude on the Mars body named in `crs`. Never Earth WGS84.
string crs
float64 origin_lat_deg
float64 origin_lon_deg
string vertical_datum           # e.g. "MOLA areoid"; heights are metres above it
float32 nodata_value            # value used in 32FC1 rasters for NoData cells

string[] sources                # one provenance entry per contributing product
string checksum_sha256          # checksum of the prior raster of this run
# ICD-ROS2-V1 | One local observation of the terrain made by an agent.
# Topic: /mge/observations  (SimulationAdapter -> Mapping, reliable)
# Only the cells listed here may change in the belief map. Re-sending the
# same observation_id must not be applied twice.

string SOURCE_SIMULATED=SIMULATED

int8 OBSTACLE_UNKNOWN=-1
int8 OBSTACLE_FREE=0
int8 OBSTACLE_BLOCKED=100

std_msgs/Header header          # frame_id = "map", stamp = simulated time
	builtin_interfaces/Time stamp
		int32 sec
		uint32 nanosec
	string frame_id
string observation_id           # unique, idempotency key
string run_id
string agent_id
uint32 base_map_version         # map version the observation was taken against
string source_kind              # SOURCE_* ; P0 is always SIMULATED

# Parallel arrays, one entry per observed cell (flat index, see TerrainMeta).
uint32[] cell_indices
float32[] elevation_m
float32[] sigma_m               # 1-sigma of the simulated sensor model
int8[] obstacle                 # OBSTACLE_*
# ICD-ROS2-V1 | State of one agent.
# Topic: /mge/agents/{agent_id}/state  (SimulationAdapter -> Mission, reliable)
# Resource values are assumptions of a simulated mission, never certified limits.

string KIND_HUMAN=HUMAN
string KIND_DRONE=DRONE
string KIND_ROVER=ROVER

string MODE_IDLE=IDLE
string MODE_MOVING=MOVING
string MODE_OBSERVING=OBSERVING
string MODE_WORKING=WORKING
string MODE_RETURNING=RETURNING
string MODE_HALTED=HALTED

std_msgs/Header header          # frame_id = "map", stamp = simulated time
	builtin_interfaces/Time stamp
		int32 sec
		uint32 nanosec
	string frame_id
string run_id
string agent_id                 # unique within the run
string agent_kind               # KIND_*
geometry_msgs/Pose pose
	Point position
		float64 x
		float64 y
		float64 z
	Quaternion orientation
		float64 x 0
		float64 y 0
		float64 z 0
		float64 w 1
geometry_msgs/Twist velocity
	Vector3  linear
		float64 x
		float64 y
		float64 z
	Vector3  angular
		float64 x
		float64 y
		float64 z
string mode                     # MODE_*

float32 time_remaining_s        # estimated
float32 energy_remaining_wh     # estimated
float32 oxygen_remaining_l      # estimated; NaN for agents that are not HUMAN
float32 confidence              # 0..1, confidence in the pose estimate
# ICD-ROS2-V1 | One ordered, idempotent mission event.
# Topic: /mge/mission/events  (Mission -> Gateway/logs, reliable)
# Consumers order by `seq` and ignore an event_id they have already applied.
# Events of another run_id must be dropped.

string TYPE_MISSION_STATE_CHANGED=MISSION_STATE_CHANGED
string TYPE_GOAL_ACCEPTED=GOAL_ACCEPTED
string TYPE_GOAL_REJECTED=GOAL_REJECTED
string TYPE_MAP_UPDATED=MAP_UPDATED
string TYPE_ROUTE_PUBLISHED=ROUTE_PUBLISHED
string TYPE_ROUTE_INVALIDATED=ROUTE_INVALIDATED
string TYPE_TASK_DISCOVERED=TASK_DISCOVERED
string TYPE_TASK_STATE_CHANGED=TASK_STATE_CHANGED
string TYPE_ERROR=ERROR

std_msgs/Header header          # stamp = simulated time
	builtin_interfaces/Time stamp
		int32 sec
		uint32 nanosec
	string frame_id
string event_id                 # unique, idempotency key
uint64 seq                      # strictly increasing within a run
string run_id
string causality_id             # event_id / request_id / observation_id that caused it
string event_type               # TYPE_*
string task_id
string agent_id
uint32 map_version
string route_id
string previous_state
string new_state
string reason_code              # machine-readable, UPPER_SNAKE_CASE
string detail                   # short English sentence for the UI
# ICD-ROS2-V1 | Authoritative mission state. Only MissionManager publishes it.
# Topic: /mge/mission/state  (Mission -> Gateway, reliable + transient_local)

string STATE_IDLE=IDLE
string STATE_PLANNING=PLANNING
string STATE_READY=READY
string STATE_ACTIVE=ACTIVE
string STATE_REPLAN=REPLAN
string STATE_RETURNING=RETURNING
string STATE_COMPLETE=COMPLETE
string STATE_BLOCKED=BLOCKED
string STATE_ABORTED=ABORTED

string TASK_DISCOVERED=DISCOVERED
string TASK_ELIGIBLE=ELIGIBLE
string TASK_ASSIGNED=ASSIGNED
string TASK_EXECUTING=EXECUTING
string TASK_DONE=DONE
string TASK_REJECTED=REJECTED
string TASK_BLOCKED=BLOCKED

