{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terrain provenance manifest (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "region_id",
    "frame_id",
    "local_origin",
    "resolution_m",
    "rows",
    "cols",
    "row_orientation",
    "vertical_units",
    "vertical_datum",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pending",
        "ready"
      ]
    },
    "region_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "const": "map"
    },
    "local_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat_planetocentric_deg",
        "lon_east_deg"
      ],
      "properties": {
        "lat_planetocentric_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon_east_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      }
    },
    "resolution_m": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "rows": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "cols": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "row_orientation": {
      "enum": [
        "north_to_south",
        "south_to_north",
        null
      ]
    },
    "vertical_units": {
      "const": "m"
    },
    "vertical_datum": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission",
          "instrument",
          "product_id",
          "source_url",
          "license_or_terms_url",
          "role",
          "native_resolution_m",
          "sha256"
        ],
        "properties": {
          "mission": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "instrument": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "product_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "license_or_terms_url": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "role": {
            "enum": [
              "prior",
              "evaluation_reference",
              "regional_context"
            ]
          },
          "native_resolution_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "vertical_datum": {
            "type": "string",
            "minLength": 1
          },
          "row_orientation": {
            "type": "string",
            "minLength": 1
          },
          "resolution_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 1
          },
          "cols": {
            "type": "integer",
            "minimum": 1
          },
          "local_origin": {
            "properties": {
              "lat_planetocentric_deg": {
                "type": "number"
              },
              "lon_east_deg": {
                "type": "number"
              }
            }
          },
          "sources": {
            "items": {
              "properties": {
                "mission": {
                  "type": "string",
                  "minLength": 1
                },
                "instrument": {
                  "type": "string",
                  "minLength": 1
                },
                "product_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1
                },
                "license_or_terms_url": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "native_resolution_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
