{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "run_id",
    "status",
    "frame_id",
    "crs",
    "vertical_datum",
    "origin",
    "rows",
    "cols",
    "resolution_m",
    "row_order",
    "index_order",
    "map_version",
    "snapshot_stamp",
    "sources",
    "layers",
    "control_points",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "provisional",
        "approved"
      ]
    },
    "frame_id": {
      "const": "map"
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "vertical_datum": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat_planetocentric_deg",
        "lon_east_deg",
        "x_m",
        "y_m"
      ],
      "properties": {
        "lat_planetocentric_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon_east_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        }
      }
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "cols": {
      "type": "integer",
      "minimum": 1
    },
    "resolution_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "row_order": {
      "const": "south_to_north"
    },
    "index_order": {
      "const": "row * cols + col"
    },
    "map_version": {
      "$ref": "#/$defs/version"
    },
    "snapshot_stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sec",
        "nanosec"
      ],
      "properties": {
        "sec": {
          "type": "integer",
          "minimum": 0
        },
        "nanosec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "source_url",
          "license_or_terms_url",
          "sha256"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "license_or_terms_url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "map_version",
          "encoding",
          "nodata",
          "source_product_ids"
        ],
        "properties": {
          "role": {
            "enum": [
              "prior",
              "belief",
              "sigma",
              "nodata_mask",
              "traversability_human",
              "traversability_rover",
              "traversability_drone"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "map_version": {
            "$ref": "#/$defs/version"
          },
          "encoding": {
            "enum": [
              "32FC1",
              "8UC1",
              "occupancy"
            ]
          },
          "nodata": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_product_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "control_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lat_planetocentric_deg",
          "lon_east_deg",
          "x_m",
          "y_m",
          "z_m",
          "tolerance_m"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lat_planetocentric_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon_east_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "x_m": {
            "type": "number"
          },
          "y_m": {
            "type": "number"
          },
          "z_m": {
            "type": "number"
          },
          "tolerance_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "state",
        "evidence"
      ],
      "properties": {
        "owner": {
          "const": "David"
        },
        "state": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public canonical dataset delivery 1.0.0 (no evaluator assets)",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "state": {
                "const": "approved"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
