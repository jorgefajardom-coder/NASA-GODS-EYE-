# ICD-ROS2-V1 | /mge/mission/set_goal  (Gateway -> Mission)
# Idempotent: repeating a request_id returns the first answer.

string request_id               # idempotency key
string run_id                   # empty = current run
string primary_agent_id
geometry_msgs/Point base
geometry_msgs/Point goal
string mode                     # RouteDecision.MODE_*

float32 time_budget_s
float32 energy_budget_wh
float32 oxygen_budget_l
float32 reserve_time_s
float32 reserve_wh
float32 reserve_oxygen_l
---
bool accepted
string request_id
string run_id
string mission_state            # MissionState.STATE_* after handling the request
string reason_code              # machine-readable, UPPER_SNAKE_CASE
string detail                   # short English sentence for the UI
