<?xml version="1.0"?>
<package format="3">
  <name>mge_gateway</name>
  <version>0.1.0</version>
  <description>Mars Gods Eye ROS to web gateway (REST and WebSocket).</description>
  <maintainer email="noreply@example.com">Houston, We Have a Bug!</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mge_interfaces</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
